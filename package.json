{
  "name": "laravel-website",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./resources/css/app.css -o ./public/css/app.css --watch",
    "build": "prisma generate && tailwindcss -i ./resources/css/app.css -o ./public/css/app.css && node ./scripts/build-auth.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.13"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.22.0"
  }
}
