# Supabase Postgres pooled connection string used by the application at runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&uselibpqcompat=true&pgbouncer=true&connection_limit=1&schema=public"

# Direct or session-mode connection used for Prisma migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"

# Optional: defaults to welc_session.
SESSION_COOKIE_NAME="welc_session"
